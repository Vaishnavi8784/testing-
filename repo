(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
    var body = request.body.data;
    var pr = JSON.parse(body);

    if (pr.action === 'opened' && pr.pull_request) {
        var change = new GlideRecord('change_request');
        change.initialize();
        change.short_description = 'GitHub PR: ' + pr.pull_request.title;
        change.description = 'Pull Request by ' + pr.pull_request.user.login + '\n\n' + pr.pull_request.body;
        change.type = 'Normal';
        change.insert();
    }

    response.setStatus(200);
})(request, response);
